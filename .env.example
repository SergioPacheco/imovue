# Copie para .env e preencha localmente. Nunca coloque tokens neste arquivo.
# Token único do System User (Meta Business, sem expiração, com acesso a
# todas as páginas). É o único secret usado pela cron em produção.
FB_SYSTEM_USER_TOKEN=cole_aqui_o_token_do_system_user
# Opcional:
# META_GRAPH_VERSION=v23.0
# Estratégia de publicação (padrões: America/Sao_Paulo, 3 posts/dia, 30 dias sem repetir):
# IMOVUE_FACEBOOK_TIMEZONE=America/Sao_Paulo
# IMOVUE_FACEBOOK_POSTS_PER_DAY=3
# IMOVUE_FACEBOOK_REPOST_AFTER_DAYS=30
